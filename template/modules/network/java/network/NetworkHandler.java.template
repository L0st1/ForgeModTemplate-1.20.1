package __JAVA_PACKAGE__.network;

import static __JAVA_PACKAGE__.__MAIN_CLASS__.MOD_ID;

import net.minecraft.resources.ResourceLocation;
import net.minecraftforge.network.NetworkDirection;
import net.minecraftforge.network.NetworkRegistry;
import net.minecraftforge.network.simple.SimpleChannel;

public final class NetworkHandler {
  private static final String PROTOCOL_VERSION = "1";

  public static final SimpleChannel CHANNEL =
      NetworkRegistry.newSimpleChannel(
          new ResourceLocation(MOD_ID, "main"),
          () -> PROTOCOL_VERSION,
          PROTOCOL_VERSION::equals,
          PROTOCOL_VERSION::equals);

  private NetworkHandler() {}

  public static void register() {
    CHANNEL
        .messageBuilder(ExampleC2SPacket.class, 0, NetworkDirection.PLAY_TO_SERVER)
        .encoder(ExampleC2SPacket::encode)
        .decoder(ExampleC2SPacket::decode)
        .consumerMainThread(ExampleC2SPacket::handle)
        .add();
  }
}
