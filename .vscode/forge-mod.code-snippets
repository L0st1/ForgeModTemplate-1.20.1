  "Mixin RETURN 注入": {
    "prefix": "forge-mixin-return",
    "description": "在方法返回点读取或替换返回值",
    "body": [
      "@Inject(method = \"${1:method}\", at = @At(\"RETURN\"), cancellable = true)",
      "private void ${2:afterMethod}(CallbackInfoReturnable<${3:ReturnType}> cir) {",
      "    cir.setReturnValue(${4:cir.getReturnValue()});",
      "}"
    ]
  },
  "C2S 网络处理": {
    "prefix": "forge-c2s-handler",
    "description": "验证 sender 并切回服务端主线程",
    "body": [
      "public static void handle(${1:Message} message, Supplier<NetworkEvent.Context> contextSupplier) {",
      "    var context = contextSupplier.get();",
      "    context.enqueueWork(() -> {",
      "        var sender = context.getSender();",
      "        if (sender == null) return;",
      "        $0",
      "    });",
      "    context.setPacketHandled(true);",
      "}"
    ]
  },
